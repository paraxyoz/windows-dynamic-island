<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="Paraxyoz.WindowsDynamicIsland" Publisher="CN=Paraxyoz, OID.2.25.311729368913984317654407730594956997722=1"
            Version="1.1.4.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Windows Dynamic Island</DisplayName>
    <PublisherDisplayName>Paraxyoz</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="ru-RU" />
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="Island" Executable="WindowsDynamicIsland.exe"
                 uap10:RuntimeBehavior="win32App" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Windows Dynamic Island" Description="Dynamic Island for Windows"
                          BackgroundColor="transparent" Square44x44Logo="Assets\Icon44.png"
                          Square150x150Logo="Assets\Icon150.png" />
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
</Package>
