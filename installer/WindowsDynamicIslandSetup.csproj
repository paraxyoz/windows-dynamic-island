<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WindowsDynamicIslandSetup</RootNamespace>
    <AssemblyName>WindowsDynamicIslandSetup</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Optimize>true</Optimize>
    <FrameworkPathOverride>C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <OutputPath>..\dist\</OutputPath>
    <IntermediateOutputPath>..\obj\Installer\$(Configuration)\</IntermediateOutputPath>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationCore">
      <HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\WPF\PresentationCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PresentationFramework">
      <HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\WPF\PresentationFramework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="WindowsBase">
      <HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\WPF\WindowsBase.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xaml">
      <HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Xaml.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\dist\WindowsDynamicIsland.exe">
      <Link>Payload\WindowsDynamicIsland.exe</Link>
      <LogicalName>Payload.WindowsDynamicIsland.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\app.ico">
      <Link>Payload\app.ico</Link>
      <LogicalName>Payload.app.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\logo.png">
      <Link>Payload\logo.png</Link>
      <LogicalName>Payload.logo.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\Sounds\applepay.mp3">
      <Link>Payload\Sounds\applepay.mp3</Link>
      <LogicalName>Payload.Sounds.applepay.mp3</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\Sounds\phonk.mp3">
      <Link>Payload\Sounds\phonk.mp3</Link>
      <LogicalName>Payload.Sounds.phonk.mp3</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\Sounds\plum.mp3">
      <Link>Payload\Sounds\plum.mp3</Link>
      <LogicalName>Payload.Sounds.plum.mp3</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\Sounds\trum.mp3">
      <Link>Payload\Sounds\trum.mp3</Link>
      <LogicalName>Payload.Sounds.trum.mp3</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="SetupProgram.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
